{
  "name": "${localEnv:DEVCONTAINER_NAME:Project}",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:UTC}"
    }
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "vscode.git",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.debugpy",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.isort",
        "Anthropic.claude-code",
        "ideonate.devs-bridge-drop",
        "ideonate.vscode-tmux-auto-reattach"
      ]
      // VS Code settings live in .devcontainer/machine-settings.json — baked into
      // the image via Dockerfile so they apply for both Dev Containers and SSH
      // remote (Tailscale SSH never reads devcontainer.json). Don't add a
      // "settings" block back here: the Dev Containers extension writes it over
      // the same machine-settings file, and the two would drift.
    }
  },
  "remoteUser": "node",
  "mounts": [
    "source=claude-code-bashhistory,target=/commandhistory,type=volume",
    "source=${localEnv:HOME}/.devs/claudeconfig,target=/home/node/claudeconfig,type=bind",
    "source=${localEnv:HOME}/.devs/codexconfig,target=/home/node/codexconfig,type=bind",
    "source=${localEnv:HOME}/.devs/hermesconfig,target=/home/node/hermesconfig,type=bind",
    "source=${localEnv:DEVS_ENV_MOUNT_PATH},target=/home/node/.devs-env,type=bind",
    "source=${localEnv:DEVS_BRIDGE_MOUNT_PATH},target=/home/node/bridge,type=bind",
    // Remove the extensions mount to get fresh state each time
    // "source=${localEnv:WORKSPACE_FOLDER_NAME}-vscode-extensions,target=/home/node/.vscode-server/extensions,type=volume",
    // .vscode-server includes extension state which we don't want to keep
    // "source=${localEnv:WORKSPACE_FOLDER_NAME}-vscode-data,target=/home/node/.vscode-server,type=volume",
    "source=${localEnv:WORKSPACE_FOLDER_NAME}-vscode-downloads,target=/home/node/.vscode-extensions-cache-volume,type=volume",
    // Persist the tailnet node identity so the container keeps one stable 100.x
    // and hostname across rebuilds — otherwise every rebuild mints a new node and
    // your saved VS Code SSH host stops resolving.
    "source=${localEnv:WORKSPACE_FOLDER_NAME}-tailscale-state,target=/var/lib/tailscale,type=volume"
  ],
  "remoteEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "LANG": "en_US.UTF-8",
    "LC_ALL": "en_US.UTF-8",
    "GIT_REMOTE_URL": "${localEnv:GIT_REMOTE_URL}",
    "WORKSPACE_FOLDER_NAME": "${localEnv:WORKSPACE_FOLDER_NAME}",
    "DEVCONTAINER_NAME": "${localEnv:DEVCONTAINER_NAME}",
    "DEVS_PROJECT_NAME": "${localEnv:DEVS_PROJECT_NAME}",
    "DEVS_DEBUG": "${localEnv:DEVS_DEBUG}",
    "DEVS_LIVE_MODE": "${localEnv:DEVS_LIVE_MODE}",
    // Opt-in: makes tmux the default terminal profile and enables auto-reattach.
    // Off unless set to 1/true/yes — see scripts/setup-vscode-settings.sh.
    "DEVS_TMUX": "${localEnv:DEVS_TMUX}",
    "DEVS_ENV_MOUNT_PATH": "${localEnv:DEVS_ENV_MOUNT_PATH}",
    "DEVS_BRIDGE_MOUNT_PATH": "${localEnv:DEVS_BRIDGE_MOUNT_PATH}"
  },
  "workspaceFolder": "/workspaces/${localEnv:WORKSPACE_FOLDER_NAME}",
  "postCreateCommand": "/usr/local/bin/post-create-wrapper.sh",
  "postStartCommand": "/usr/local/bin/post-start.sh",
  "forwardPorts": [],
  "portsAttributes": {
    "3306": {
      "onAutoForward": "ignore"
    },
    "6379": {
      "onAutoForward": "ignore"
    }
  }
}
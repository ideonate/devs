{
  "editor.formatOnSave": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "[python]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.tabSize": 4,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "python.defaultInterpreterPath": "/home/node/.devs-venv/workspace-venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.interpreter.infoVisibility": "never",
  "python.venvFolders": [".devs-venv"],
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.diagnosticSeverityOverrides": {
    "reportUnusedImport": "information",
    "reportUnusedVariable": "information"
  },
  "pylint.enabled": false,
  "gitlens.mode": "zen",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "settingsSync.ignoredExtensions": [],
  "settingsSync.keybindingsPerPlatform": false,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  "extensions.ignoreRecommendations": true,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "icon": "terminal-bash"
    },
    "zsh": {
      "path": "zsh"
    },
    "tmux": {
      "path": "tmux",
      "args": ["new-session"]
    }
  },
  "terminal.integrated.macOptionClickForcesSelection": true,
  "tmuxAutoReattach.runOnStartup": false,
  "tmuxAutoReattach.skipIfTerminalsOpen": true,
  "tmuxAutoReattach.listCommand": "tmux list-sessions -F \"#{session_name}\"",
  "tmuxAutoReattach.attachCommand": "tmux attach -t {session}",
  "tmuxAutoReattach.shellPath": "/bin/sh",
  "tmuxAutoReattach.shellArgs": ["-c"],
  "tmuxAutoReattach.liveTitles": true,
  "tmuxAutoReattach.titleCommand": ""
}
